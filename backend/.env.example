# ============================================================
# Modèle de configuration BACKEND
# ------------------------------------------------------------
# 1) Copier ce fichier vers « backend/.env »
# 2) Remplacer chaque valeur « change-me… » par une vraie valeur
# 3) NE JAMAIS committer « backend/.env » (il est ignoré par Git)
# ============================================================

NODE_ENV=development
PORT=3001

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me

DB_DATABASE=luxury_car_rental

# --- Agency-only vehicle rentals ---
# Used only when a vehicle has no explicit home-agency mapping.
DEFAULT_RENTAL_AGENCY_CODE=BUD-SHOWROOM

# Minutes after the scheduled agency collection time before an unhanded reservation becomes NO_SHOW.
NO_SHOW_GRACE_PERIOD_MINUTES=120
NO_SHOW_SCAN_INTERVAL_MS=60000

# --- Transactional Email & SMTP (Outbox) ---
# Leave SMTP_HOST empty in local development to use the built-in local outbox transport.
# When SMTP_USER is set, SMTP_PASSWORD must also be set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LUXUAR Concierge <no-reply@luxuar.hu>"
SMTP_TIMEOUT_MS=10000
EMAIL_OUTBOX_MAX_ATTEMPTS=3
EMAIL_OUTBOX_BASE_DELAY_MS=30000
EMAIL_OUTBOX_SCAN_INTERVAL_MS=30000

# --- Sécurité ---
# JWT_SECRET doit contenir AU MOINS 32 caractères (validation zod).
# Générer par ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# --- Scripts de démonstration ---
# Autorise les scripts de seed destructifs. Laisser à false par défaut.
ALLOW_DESTRUCTIVE_DEMO_SEED=false

# --- Stripe Test Mode ---
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
FRONTEND_URL=http://localhost:3000
